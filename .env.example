# ─────────────────────────────────────────────────────────────
# BloomIQ — environment template
# Copy to `.env` and fill in the values marked "CHANGE ME".
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Runtime connects via DATABASE_URL; Prisma CLI / migrations use DIRECT_URL.
# The defaults below match docker-compose.dev.yml — no change needed for local dev.
# For Neon (production): DATABASE_URL = pooled string, DIRECT_URL = direct string.
DATABASE_URL="postgresql://bloom_user:bloom_password@localhost:5432/bloom_iq"
DIRECT_URL="postgresql://bloom_user:bloom_password@localhost:5432/bloom_iq"

# ── Authentication (Better Auth) ─────────────────────────────
# Generate a secret:  openssl rand -base64 32
# (Windows without openssl:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET="CHANGE ME - random string, 32+ characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI provider ─────────────────────────────────────────────
# GEMINI (cloud, recommended) or OLLAMA (local). Must be set explicitly.
AI_PROVIDER="GEMINI"

# ── Gemini config (required when AI_PROVIDER=GEMINI) ─────────
# Free key: https://aistudio.google.com/app/apikey
# Add GEMINI_API_KEY_1 .. GEMINI_API_KEY_10 for round-robin rotation (optional).
GEMINI_API_KEY="CHANGE ME - your Gemini API key"
# GEMINI_API_KEY_1=""
# GEMINI_MODEL="gemini-2.5-flash"

# ── Ollama config (required when AI_PROVIDER=OLLAMA) ─────────
# Install: https://ollama.com/download
#   ollama pull mistral:7b
#   ollama pull nomic-embed-text:v1.5
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="mistral:7b"
# OLLAMA_EMBEDDING_MODEL="nomic-embed-text:v1.5"

# ── Optional: real-world grounding for question generation ───
# TAVILY_API_KEY=""
# SERPER_API_KEY=""

# ── Optional ────────────────────────────────────────────────
# Fill paper slots with placeholder questions when the approved
# question bank is short (auto-on outside production).
# ENABLE_DEMO_FALLBACK_QUESTIONS="true"

NODE_ENV="development"
